            <column-instance column='[LEAGUE_NAME (DIM_LEAGUE2)]' derivation='None' name='[none:LEAGUE_NAME (DIM_LEAGUE2):nk]' pivot='key' type='nominal' />
            <column-instance column='[LEAGUE_NAME]' derivation='None' name='[none:LEAGUE_NAME:nk]' pivot='key' type='nominal' />
            <column-instance column='[MATCH_SK]' derivation='Count' name='[pcto:cnt:MATCH_SK:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
