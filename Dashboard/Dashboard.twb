          <formatted-text>
            <run bold='true' fontname='Radikal' fontsize='10'>Highest Captain Win Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='FACT_CONTRACT (PROD.FACT_CONTRACT)+ (DBT_DEV_MARTS)' name='federated.0nq4rm51uz8drv0zt3jni07iupmf' />
