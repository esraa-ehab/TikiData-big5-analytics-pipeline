            <column caption='Team Name' datatype='string' name='[TEAM_NAME]' role='dimension' type='nominal' />
            <column-instance column='[CAPTAIN_NAME]' derivation='None' name='[none:CAPTAIN_NAME:nk]' pivot='key' type='nominal' />
