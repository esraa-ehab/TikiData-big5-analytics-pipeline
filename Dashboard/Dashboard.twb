              <calculation class='tableau' formula='IF [GOALS_SCORED] &gt; [GOALS_CONCEDED] THEN &quot;Win&quot; ELSEIF [GOALS_SCORED] = [GOALS_CONCEDED] THEN &quot;Draw&quot; ELSE &quot;Loss&quot; END' />
