    <worksheet name='possession correlation'>
      <table>
        <view>
          <datasources>
            <datasource caption='FACT_CONTRACT (PROD.FACT_CONTRACT)+ (DBT_DEV_MARTS)' name='federated.0nq4rm51uz8drv0zt3jni07iupmf' />
          </datasources>
          <datasource-dependencies datasource='federated.0nq4rm51uz8drv0zt3jni07iupmf'>
            <column caption='Possession Bin' datatype='string' name='[Calculation_1418096674869249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [POSSESSION] &lt; 40 THEN &quot;Under 40%&quot;&#13;&#10;ELSEIF [POSSESSION] &lt; 50 THEN &quot;40–50%&quot;&#13;&#10;ELSEIF [POSSESSION] &lt; 60 THEN &quot;50–60%&quot;&#13;&#10;ELSE &quot;60%+&quot;&#13;&#10;END' />
            </column>
            <column caption='Match result' datatype='string' name='[Calculation_1909028370857985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [GOALS_SCORED] &gt; [GOALS_CONCEDED] THEN &quot;Win&quot; ELSEIF [GOALS_SCORED] = [GOALS_CONCEDED] THEN &quot;Draw&quot; ELSE &quot;Loss&quot; END' />
            </column>
            <column caption='Goals Conceded' datatype='integer' name='[GOALS_CONCEDED]' role='measure' type='quantitative' />
            <column caption='Goals Scored' datatype='integer' name='[GOALS_SCORED]' role='measure' type='quantitative' />
            <column caption='League Name (Dim League2)' datatype='string' name='[LEAGUE_NAME (DIM_LEAGUE2)]' role='dimension' type='nominal' />
            <column caption='League Name' datatype='string' name='[LEAGUE_NAME]' role='dimension' type='nominal' />
            <column caption='Match Sk' datatype='string' name='[MATCH_SK]' role='dimension' type='nominal' />
            <column caption='Possession' datatype='integer' name='[POSSESSION]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1418096674869249]' derivation='None' name='[none:Calculation_1418096674869249:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1909028370857985]' derivation='None' name='[none:Calculation_1909028370857985:nk]' pivot='key' type='nominal' />
            <column-instance column='[LEAGUE_NAME (DIM_LEAGUE2)]' derivation='None' name='[none:LEAGUE_NAME (DIM_LEAGUE2):nk]' pivot='key' type='nominal' />
            <column-instance column='[LEAGUE_NAME]' derivation='None' name='[none:LEAGUE_NAME:nk]' pivot='key' type='nominal' />
            <column-instance column='[MATCH_SK]' derivation='Count' name='[pcto:cnt:MATCH_SK:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <manual-sort column='[federated.0nq4rm51uz8drv0zt3jni07iupmf].[none:Calculation_1418096674869249:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Under 40\%&quot;</bucket>
              <bucket>&quot;40–50\%&quot;</bucket>
              <bucket>&quot;50–60\%&quot;</bucket>
              <bucket>&quot;60\%+&quot;</bucket>
