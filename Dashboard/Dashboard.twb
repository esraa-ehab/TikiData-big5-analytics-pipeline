      <column caption='Country (Dim League2)' datatype='string' name='[COUNTRY (DIM_LEAGUE2)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='current_season_w' datatype='integer' name='[Calculation_1001242648678400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [SEASON (FACT_STANDING)] = { FIXED : MAX([SEASON (FACT_STANDING)]) } THEN [WINS] END))' />
      </column>
      <column caption='last_season_w' datatype='integer' name='[Calculation_1001242651541507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [SEASON (FACT_STANDING)] = { FIXED : MAX([SEASON (FACT_STANDING)]) } - 1 THEN [WINS] ELSE 0 END)' />
      </column>
      <column caption='Possession Bin' datatype='string' name='[Calculation_1418096674869249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [POSSESSION] &lt; 40 THEN &quot;Under 40%&quot;&#13;&#10;ELSEIF [POSSESSION] &lt; 50 THEN &quot;40–50%&quot;&#13;&#10;ELSEIF [POSSESSION] &lt; 60 THEN &quot;50–60%&quot;&#13;&#10;ELSE &quot;60%+&quot;&#13;&#10;END' />
      </column>
      <column caption='Win Flag' datatype='integer' name='[Calculation_1418096675024898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1909028370857985] = &quot;Win&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='blank' datatype='string' name='[Calculation_1872261297283072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Show&quot;' />
      </column>
      <column caption='Goal difference ' datatype='integer' name='[Calculation_1909028370710528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GOALS_SCORED] - [GOALS_CONCEDED]' />
      </column>
      <column caption='Match result' datatype='string' name='[Calculation_1909028370857985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [GOALS_SCORED] &gt; [GOALS_CONCEDED] THEN &quot;Win&quot; ELSEIF [GOALS_SCORED] = [GOALS_CONCEDED] THEN &quot;Draw&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column caption='Win rate %' datatype='real' name='[Calculation_1909028371230722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_1909028370857985] = &quot;Win&quot; THEN 1 ELSE 0 END) / COUNT([MATCH_SK])' />
      </column>
      <column caption='ROUND(Avg([Pts]), 2)' datatype='real' name='[Calculation_2591479375785984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(Avg([POINTS]), 2)' />
      </column>
      <column caption='GD' datatype='integer' name='[Calculation_2591479388995588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([GOALS_SCORED (FACT_STANDING)]-[GOALS_CONCEDED (FACT_STANDING)])' />
      </column>
