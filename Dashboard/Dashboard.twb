          </datasources>
          <datasource-dependencies datasource='federated.0nq4rm51uz8drv0zt3jni07iupmf'>
            <column caption='Match result' datatype='string' name='[Calculation_1909028370857985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [GOALS_SCORED] &gt; [GOALS_CONCEDED] THEN &quot;Win&quot; ELSEIF [GOALS_SCORED] = [GOALS_CONCEDED] THEN &quot;Draw&quot; ELSE &quot;Loss&quot; END' />
            </column>
            <column caption='Win rate %' datatype='real' name='[Calculation_1909028371230722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1909028370857985] = &quot;Win&quot; THEN 1 ELSE 0 END) / COUNT([MATCH_SK])' />
            </column>
            <column caption='Full Date' datatype='date' name='[FULL_DATE]' role='dimension' type='ordinal' />
