            <column caption='Team Name' datatype='string' name='[TEAM_NAME]' role='dimension' type='nominal' />
            <column-instance column='[LEAGUE_NAME (DIM_LEAGUE2)]' derivation='None' name='[none:LEAGUE_NAME (DIM_LEAGUE2):nk]' pivot='key' type='nominal' />
