      <column caption='Avg Points Per Match' datatype='real' name='[AVG_POINTS_PER_MATCH]' role='measure' type='quantitative' />
      <column caption='Captain Sk' datatype='string' name='[CAPTAIN_SK]' role='dimension' type='nominal' />
      <column caption='Contract Sk' datatype='string' name='[CONTRACT_SK]' role='dimension' type='nominal' />
      <column caption='Country (Dim League1)' datatype='string' name='[COUNTRY (DIM_LEAGUE1)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='current_season_w' datatype='integer' name='[Calculation_1001242648678400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [SEASON (FACT_STANDING)] = { FIXED : MAX([SEASON (FACT_STANDING)]) } THEN [WINS] END))' />
      </column>
      <column caption='last_season_w' datatype='integer' name='[Calculation_1001242651541507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [SEASON (FACT_STANDING)] = { FIXED : MAX([SEASON (FACT_STANDING)]) } - 1 THEN [WINS] ELSE 0 END)' />
      </column>
      <column caption='blank' datatype='string' name='[Calculation_1872261297283072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Show&quot;' />
      </column>
      <column caption='ROUND(Avg([Pts]), 2)' datatype='real' name='[Calculation_2591479375785984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(Avg([POINTS]), 2)' />
      </column>
      <column caption='GD' datatype='integer' name='[Calculation_2591479388995588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([GOALS_SCORED (FACT_STANDING)]-[GOALS_CONCEDED (FACT_STANDING)])' />
      </column>
      <column caption='Date Sk (Dim Date)' datatype='integer' name='[DATE_SK (DIM_DATE)]' role='measure' type='quantitative' />
      <column caption='Date Sk' datatype='integer' name='[DATE_SK]' role='measure' type='quantitative' />
      <column datatype='integer' name='[DAY]' role='dimension' type='quantitative' />
      <column caption='Day Of Week' datatype='string' name='[DAY_OF_WEEK]' role='dimension' type='nominal' />
      <column caption='D' datatype='integer' name='[DRAWS]' role='measure' type='quantitative' />
      <column caption='End Age (Dim Player1)' datatype='integer' name='[END_AGE (DIM_PLAYER1)]' role='measure' type='quantitative' />
